# Resend-API-Schlüssel im Hosting hinterlegen; keine echten Schlüssel einchecken.
# Ohne Schlüssel liefert /api/kontakt 501 und bietet den manuellen E-Mail-Versand an.
RESEND_API_KEY=

# Absenderadresse einer in Resend verifizierten Domain.
# Standard, wenn leer: BOUND FOR FUTURE <noreply@monvex-group.de>
CONTACT_FROM_EMAIL=

# Empfänger der Anfragen (mehrere Adressen mit Komma trennen).
# Leer = BRAND.email aus lib/content.ts.
CONTACT_TO_EMAIL=

# Öffentliche Kontaktadresse: BRAND.email in lib/content.ts.
# Aktuell: mudi@monvex-group.de
